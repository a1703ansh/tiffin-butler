# ===== REQUIRED =====
# Notion integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=

# ===== OPTIONAL OVERRIDES =====
# Database/page IDs. If left blank, the service auto-resolves them by title
# from the workspace (recommended for portability).
NOTION_ORDERS_DB_ID=
NOTION_RUN_LOG_DB_ID=
# Page where stray WhatsApp messages can be pasted for the watcher to process.
NOTION_INBOX_PAGE_ID=

# ===== AI (LLM) =====
# Free tier: Groq (https://console.groq.com/keys) -> use its OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ===== EMAIL =====
# Free tier: Resend (https://resend.com/api-keys). Sandbox domain can only
# deliver to EMAIL_TO (the account owner's verified inbox).
RESEND_API_KEY=
EMAIL_FROM=Tiffin Butler <onboarding@resend.dev>
# Fallback inbox when the customer's email is missing/unknown.
EMAIL_TO=thakur71039@gmail.com
# "sandbox" (default): ALL emails go to EMAIL_TO, customer's parsed email is
# noted in subject/body. "customer": send to the customer's parsed email
# (requires a verified Resend domain — see docs/deploy.md).
EMAIL_DELIVERY=sandbox

# ===== SERVER =====
PORT=3000
# Public URL, used in status pages and demo emails.
APP_URL=http://localhost:3000

# ===== SAFETY =====
# Set to "false" to disable Run Log writes (useful for local experiments).
RUN_LOG_ENABLED=true